{
  "name": "alina-vue-front-end",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite --mode development",
    "dev:sss": "vite --mode sss",
    "dev:m45a": "vite --mode m45a",
    "dev:vov": "vite --mode vov",
    "dev:zero": "vite --mode zero",
    "dev:stage": "vite --mode stage",
    "build": "vite build",
    "build:sss": "vite build --mode sss",
    "build:m45a": "vite build --mode m45a",
    "build:vov": "vite build --mode vov",
    "build:zero": "vite build --mode zero",
    "build:stage": "vite build --mode stage",
    "build:all": "npm run build:vov && npm run build:zero",
    "check:vite": "node scripts/check-vite-contract.mjs",
    "check:vue3": "node scripts/check-vue3-contract.mjs",
    "check:bootstrap5": "node scripts/check-bootstrap5-contract.mjs",
    "check:media-embed": "node scripts/check-video-embed-contract.mjs",
    "check:chat-rooms": "node scripts/check-chat-rooms-contract.mjs",
    "check:chat": "node scripts/check-chat-contract.mjs",
    "check:chat-voice-recorder": "node scripts/check-chat-voice-recorder-contract.mjs",
    "check:chat-voice-ui": "node scripts/check-chat-voice-ui-contract.mjs",
    "check:chat-mentions": "node scripts/check-chat-mentions-contract.mjs",
    "check:chat-activity": "node scripts/check-chat-activity-contract.mjs",
    "check:feed-navigation": "node scripts/check-feed-navigation-contract.mjs",
    "check:file-list": "node scripts/check-file-list.mjs",
    "check:migration": "npm run check:vite && npm run check:vue3 && npm run check:bootstrap5 && npm run check:media-embed && npm run check:chat && npm run check:chat-rooms && npm run check:chat-voice-recorder && npm run check:chat-voice-ui && npm run check:chat-mentions && npm run check:chat-activity && npm run check:feed-navigation && npm run check:file-list"
  },
  "dependencies": {
    "@ckeditor/ckeditor5-vue": "^8.2.0",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "bootstrap-vue-next": "^1.1.0",
    "ckeditor5": "^48.5.0",
    "core-js": "^3.47.0",
    "date-fns": "^4.1.0",
    "lodash": "^4.18.1",
    "material-design-icons": "^3.0.1",
    "npm-check-updates": "^19.3.1",
    "sprintf-js": "^1.1.3",
    "vue": "^3.5.42",
    "vue-i18n": "11.4.2",
    "vue-router": "^4.6.4",
    "vue-yandex-maps": "0.12.7",
    "vue3-cookies": "^1.0.6",
    "vuex": "^4.1.0",
    "whatwg-fetch": "^3.6.20"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/compiler-sfc": "^3.5.42",
    "autoprefixer": "^10.6.0",
    "postcss": "^8.5.28",
    "sass": "^1.97.2",
    "vite": "^8.0.16"
  }
